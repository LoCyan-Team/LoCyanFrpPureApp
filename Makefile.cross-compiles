export PATH := $(PATH):`go env GOPATH`/bin
export GO111MODULE=on
LDFLAGS := -s -w

# -------------------------------------------------------------------------
# 1. 平台列表配置
# -------------------------------------------------------------------------

# 普通构建列表
OS_ARCHS := darwin:amd64 darwin:arm64 freebsd:amd64 \
	linux:amd64 linux:arm:7 linux:arm:5 linux:arm64 \
	windows:amd64 windows:arm64 \
	linux:mips64 linux:mips64le linux:mips:softfloat linux:mipsle:softfloat \
	linux:riscv64 linux:loong64

# 只构建 frpc 的列表
FRPC_ONLY_ARCHS := android:amd64 android:arm android:arm64 android:386

# 需要开启 CGO 的列表
CGO_ENABLED_ARCHS := android:amd64 android:arm android:arm64 android:386

# 组合所有列表并去重
ALL_ARCHS := $(shell echo $(OS_ARCHS) $(FRPC_ONLY_ARCHS) $(CGO_ENABLED_ARCHS) | tr ' ' '\n' | sort -u)

# -------------------------------------------------------------------------
# 2. 构建逻辑
# -------------------------------------------------------------------------

.PHONY: all build app clean

all: build

build: app

# 确保输出目录存在
app: | release_dir

release_dir:
	@mkdir -p ./release

# -------------------------------------------------------------------------
# 3. 核心模板函数 (DO_BUILD)
#    参数 $(1): 完整的平台字符串 (例如 linux:arm:7)
# -------------------------------------------------------------------------
define DO_BUILD
  # 1. 解析参数
  $(eval PARAMS := $(subst :, ,$(1)))
  $(eval OS := $(word 1,$(PARAMS)))
  $(eval ARCH := $(word 2,$(PARAMS)))
  $(eval EXTRA := $(word 3,$(PARAMS)))

  # 2. 计算属性
  $(eval IS_FRPC_ONLY := $(if $(filter $(1),$(FRPC_ONLY_ARCHS)),1,0))
  $(eval USE_CGO := $(if $(filter $(1),$(CGO_ENABLED_ARCHS)),1,0))

  # 3. 基础文件名后缀
  $(eval SUFFIX := $(OS)_$(ARCH))
  
  # 4. 初始化构建参数
  $(eval BUILD_ENV := CGO_ENABLED=$(USE_CGO) GOOS=$(OS) GOARCH=$(ARCH))
  $(eval BUILD_MODE := )
  $(eval FILE_EXT := )
  $(eval FILE_PREFIX := )

  # 5. 处理特殊平台逻辑 (Linux ARM/MIPS, Windows, Android)
  
  # --- Linux ARM 特殊处理 ---
  $(if $(filter linux,$(OS)),\
    $(if $(filter arm,$(ARCH)),\
      $(if $(filter 7,$(EXTRA)),\
         $(eval SUFFIX := $(OS)_arm_hf)\
         $(eval BUILD_ENV += GOARM=7),\
      )\
      $(if $(filter 5,$(EXTRA)),\
         $(eval SUFFIX := $(OS)_arm)\
         $(eval BUILD_ENV += GOARM=5),\
      )\
    )\
  )

  # --- Linux MIPS 特殊处理 ---
  $(if $(filter linux,$(OS)),\
    $(if $(filter mips mipsle,$(ARCH)),\
      $(if $(EXTRA),\
        $(eval BUILD_ENV += GOMIPS=$(EXTRA)),\
      )\
    )\
  )

  # --- Windows 后缀 ---
  $(if $(filter windows,$(OS)),\
     $(eval FILE_EXT := .exe)\
  )

  # --- Android 库文件处理 ---
  $(if $(filter android,$(OS)),\
     $(eval FILE_PREFIX := lib)\
     $(eval FILE_EXT := .so)\
     $(if $(filter 1,$(USE_CGO)),\
        $(eval BUILD_MODE := -buildmode=c-shared),\
     )\
  )

  # 6. 生成构建命令 (frpc)
  #    注意：这里生成的是具体的 make target 命令
  #    使用 @echo 确保在执行前打印
  
  # 将当前架构添加到 app 依赖中
  app: build_$(OS)_$(ARCH)$(if $(EXTRA),_$(EXTRA))

  # 定义该架构的具体构建规则
build_$(OS)_$(ARCH)$(if $(EXTRA),_$(EXTRA)):
	@echo "--------------------------------------------------"
	@echo "Target: $(1)"
	@echo "  -> OS: $(OS), Arch: $(ARCH), Extra: $(EXTRA)"
	@echo "  -> CGO: $(USE_CGO), Mode: $(if $(BUILD_MODE),$(BUILD_MODE),default)"
	@echo "  -> Building frpc..."
	@env $(BUILD_ENV) go build $(BUILD_MODE) -trimpath -ldflags "$(LDFLAGS)" -tags frpc -o ./release/$(FILE_PREFIX)frpc_$(SUFFIX)$(FILE_EXT) ./cmd/frpc
	@if [ "$(IS_FRPC_ONLY)" = "0" ]; then \
		echo "  -> Building frps..."; \
		env CGO_ENABLED=0 GOOS=$(OS) GOARCH=$(ARCH) $(if $(filter linux,$(OS)),$(if $(filter arm,$(ARCH)),$(if $(filter 7,$(EXTRA)),GOARM=7))$(if $(filter 5,$(EXTRA)),GOARM=5)$(if $(filter mips mipsle,$(ARCH)),GOMIPS=$(EXTRA))) go build -trimpath -ldflags "$(LDFLAGS)" -tags frps -o ./release/$(FILE_PREFIX)frps_$(SUFFIX)$(FILE_EXT) ./cmd/frps; \
	fi
	@echo "  -> Done."

endef

# -------------------------------------------------------------------------
# 4. 循环生成规则
# -------------------------------------------------------------------------

# 使用 foreach 遍历列表，并 eval 执行上面的模板
$(foreach item,$(ALL_ARCHS),$(eval $(call DO_BUILD,$(item))))

clean:
	rm -rf ./release
